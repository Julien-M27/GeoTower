<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Permission de bibliothÃ¨que requise par PlaceListMapTemplate pour les apps POI. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- UtilisÃ©e sÃ©parÃ©ment par les widgets et le suivi en arriÃ¨re-plan, jamais demandÃ©e par Android Auto. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Generation locale de la base : un service au premier plan garde le process en vie mais
         n'empeche PAS la suspension du CPU ecran eteint. Sans wake lock, un build long est
         interrompu en boucle des que l'utilisateur range son telephone. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- MapLibre requiert OpenGL ES 3.0 dans son manifeste AAR, ce qui fait filtrer par Google Play
         tous les appareils n'ayant qu'OpenGL ES 2.0. On retire cette exigence stricte du manifeste
         fusionnÃ© pour prÃ©server l'accÃ¨s 2D Ã  tous les anciens appareils, la 3D Ã©tant protÃ©gÃ©e
         par une vÃ©rification dynamique au runtime dans le code Kotlin. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        tools:node="remove" />

    <queries>
        <!-- HÃ´te Android Auto : la visibilitÃ© du paquet est nÃ©cessaire pour lire sa version dans
             le journal de diagnostic, la liaison seule ne la garantit pas au moment d'onCreate. -->
        <package android:name="com.google.android.projection.gearhead" />
        <package android:name="fr.enb_analytics.enb4g" />
        <package android:name="com.sfrmap.android" />
        <!-- CellularFR masquÃ© â€” voir CellularFrApi.ENABLED -->
        <package android:name="com.luisbaker.cellularfr" />
        <package android:name="org.rncteam.rncfreemobile" />
        <!-- Garmin Connect Mobile pour la communication BLE avec les montres Connect IQ -->
        <package android:name="com.garmin.android.apps.connectmobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:name=".GeoTowerApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_geotower"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_geotower_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GeoRadio"
        tools:targetApi="31">

        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <!-- Doit rester au niveau <application> : AppInfo.create(), premier appel de l'hÃ´te aprÃ¨s
             le bind du CarAppService, lit cette clÃ© dans ApplicationInfo.metaData. PosÃ©e sur le
             <service>, elle atterrit dans ServiceInfo.metaData, invisible d'ici : la poignÃ©e de
             main Ã©choue sur une IllegalArgumentException et l'hÃ´te se dÃ©connecte sans rien
             afficher. Couvert par CarAppHandshakeTest. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GeoRadio">

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geotower" />
            </intent-filter>

            <!-- âœ… AJOUTER : Pour geotower://support/... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geotower" android:host="support" />
            </intent-filter>

            <!-- âœ… AJOUTER : Pour geotower://site/... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geotower" android:host="site" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

        </activity>

        <!-- Les alias de lanceur (icone au choix de l'utilisateur) vivent dans src/mobile : sur
             Android Automotive OS, le lanceur de la voiture ne doit proposer que CarAppActivity,
             jamais l'UI telephone â€” c'est elle qui s'affichait mal placee et trop petite. -->

        <receiver
            android:name=".widget.AntennaWidgetReceiver"
            android:label="@string/antenna_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/antenna_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.AntennaWidgetMediumReceiver"
            android:label="@string/antenna_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/antenna_widget_medium_info" />
        </receiver>
        <receiver
            android:name=".widget.AntennaWidgetLargeReceiver"
            android:label="@string/antenna_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/antenna_widget_large_info" />
        </receiver>
        <receiver
            android:name=".widget.AntennaMapWidgetReceiver"
            android:label="@string/antenna_map_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/antenna_map_widget_info" />
        </receiver>
        <!-- Boutons du rappel de trajet. Non exportÃ© : seules les notifications de l'app le
             dÃ©clenchent, via des PendingIntent qu'elle a elle-mÃªme construits. -->
        <receiver
            android:name=".data.workers.TripReminderActionReceiver"
            android:exported="false" />

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|connectedDevice"
            tools:node="merge" />

        <service
            android:name=".services.LiveTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".services.garmin.GarminCompanionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Service d'Ã©coute Wearable pour rÃ©pondre aux requÃªtes de la montre Wear OS -->
        <service
            android:name=".services.wear.WearablePhoneListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/geotower"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/geotower" />
            </intent-filter>
        </service>

        <!-- Android Auto must discover this exported CarAppService; release hosts are restricted in createHostValidator(). -->
        <service
            android:name=".services.GeoTowerCarAppService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher_geotower"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
        <!-- RÃ©cepteur vocal pour l'Assistant Android / Gemini (App Actions / Shortcuts) -->
        <receiver
            android:name=".assistant.GeminiAntennaReceiver"
            android:permission="android.permission.ACCESS_FINE_LOCATION"
            android:exported="true">
            <intent-filter>
                <action android:name="fr.geotower.action.VOICE_QUERY_ANTENNA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
